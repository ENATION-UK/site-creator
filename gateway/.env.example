PORT=8790
LISTEN_HOST=127.0.0.1
DATABASE_PATH=./data/app.db

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Cloudflare account with Pages Edit token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Public URL of this gateway (used in admin copy and health)
GATEWAY_PUBLIC_URL=https://site.yizo.ai

# Optional proxy for calling Cloudflare from mainland China
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

MAX_SITES_PER_CLIENT=3
MAX_DEPLOYS_PER_DAY=10
MAX_UPLOAD_MB=15
MAX_PAGES_PROJECTS=100

# Local testing only. Skips Cloudflare upload and returns a fake pages.dev URL.
# CLOUDFLARE_DRY_RUN=1
