[Unit]
Description=Trade site gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/trade-site/gateway
EnvironmentFile=/opt/trade-site/gateway/.env
ExecStart=/root/.nvm/versions/node/v22.22.2/bin/node src/index.js
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
